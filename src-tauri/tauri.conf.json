{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "SnapRust",
  "version": "0.1.0",
  "identifier": "com.snaprust.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:"
    },
    "windows": [
      {
        "label": "overlay",
        "title": "SnapRust",
        "visible": false,
        "fullscreen": false,
        "decorations": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "transparent": true,
        "shadow": false,
        "resizable": false
      },
      {
        "label": "history",
        "title": "SnapRust 截图历史",
        "url": "index.html",
        "visible": false,
        "width": 1080,
        "height": 720,
        "decorations": false,
        "center": true,
        "shadow": true,
        "resizable": true
      },
      {
        "label": "settings",
        "title": "SnapRust 翻译设置",
        "url": "index.html",
        "visible": false,
        "width": 640,
        "height": 600,
        "decorations": false,
        "center": true,
        "shadow": true,
        "resizable": false
      }
    ]
  },
  "bundle": {
    "active": false,
    "targets": "all"
  }
}
